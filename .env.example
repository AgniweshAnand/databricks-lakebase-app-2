# Copy this file to .env for local development.
# In production on Databricks Apps, these are set via app.yaml env vars
# and secrets are pulled at runtime via the Databricks SDK - do NOT put
# real secret values in this file or commit a filled-in .env.

LAKEBASE_INSTANCE_NAME=massive-lakebase
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_HOST=<your-lakebase-host>.database.cloud.databricks.com
LAKEBASE_PORT=5432
LAKEBASE_USER=<your-databricks-user-or-service-principal>

MASSIVE_API_BASE_URL=https://api.massive.example.com
MASSIVE_SECRET_SCOPE=massive
MASSIVE_SECRET_KEY=api-key
